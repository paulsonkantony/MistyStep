<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tray app: entry point, tray, pairing wizard, settings, device list. Produces MistyStep.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MistyStep.App</RootNamespace>
    <AssemblyName>MistyStep</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MistyStep.Server\MistyStep.Server.csproj" />
    <ProjectReference Include="..\MistyStep.Windows\MistyStep.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
